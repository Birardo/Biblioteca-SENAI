@model IEnumerable<BibliotecaSenai.Models.Livro>

@{
    ViewData["Title"] = "Biblioteca Senai";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-0"><i class="bi bi-book-half"></i>Livros</h2>
            <small class="text-muted">Gerencie as obras cadastradas na biblioteca</small>
        </div>
        <a asp-action="Criar" class="btn btn-primary shadow-sm">
            + Cadastrar Novo Livro
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Categoria</th>
                            <th>Editora</th>
                            <th>Ano</th>
                            <th>Preço</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Nenhum livro encontrado.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@item.Id</td>
                                    <td>@item.Titulo</td>
                                    <td>@(item.Autor?.Nome ?? "N/A")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @(item.Categoria?.Nome ?? "N/A")
                                        </span>
                                    </td>
                                    <td>@(item.Editora?.Nome ?? "N/A")</td>
                                    <td>@item.AnoPublicacao</td>
                                    <td class="fw-semibold text-success">@item.Preco.ToString("C")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                                Editar
                                            </a>
                                            <a asp-action="Deletar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                                Excluir
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>